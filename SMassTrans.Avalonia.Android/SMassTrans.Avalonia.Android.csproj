<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ApplicationId>silvercraft.SMassTrans.Avalonia</ApplicationId>
        <ApplicationVersion>23</ApplicationVersion>
        <ApplicationDisplayVersion>23.0</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <UseMaui>true</UseMaui>
        <Configurations>Debug;Release</Configurations>
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <AndroidCreatePackagePerAbi>true</AndroidCreatePackagePerAbi>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
        <JavaSdkDirectory>/usr/lib/jvm/java-17-openjdk/</JavaSdkDirectory>
        <AndroidSdkDirectory>/opt/android-sdk</AndroidSdkDirectory>
    </PropertyGroup>
    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\Icon.png</Link>
        </AndroidResource>
    </ItemGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="11.2.3" />
        <PackageReference Include="Avalonia.Maui" Version="11.1.0" />
        <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.20" />
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.13" />
        <PackageReference Update="Microsoft.Maui.Controls" Version="8.0.100" />
        <PackageReference Update="Microsoft.Maui.Controls.Compatibility" Version="8.0.100" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SMassTrans.Avalonia\SMassTrans.Avalonia.csproj" />
    </ItemGroup>
</Project>
