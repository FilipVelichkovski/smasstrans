<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0-android</TargetFramework>
        <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ApplicationId>silvercraft.SMassTrans.Avalonia</ApplicationId>
        <ApplicationVersion>18</ApplicationVersion>
        <ApplicationDisplayVersion>18.0</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
        <UseMaui>true</UseMaui>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
        <JavaSdkDirectory>/usr/lib/jvm/java-17-openjdk/</JavaSdkDirectory>
        <AndroidSdkDirectory>/opt/android-sdk</AndroidSdkDirectory>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\Icon.png</Link>
        </AndroidResource>
    </ItemGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <RunAOTCompilation>true</RunAOTCompilation>
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
        <AndroidCreatePackagePerAbi>true</AndroidCreatePackagePerAbi>
        <AndroidSupportedAbis>armeabi-v7a;arm64-v8a;x86_64</AndroidSupportedAbis>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <WarningLevel>9999</WarningLevel>
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
        <AndroidCreatePackagePerAbi>true</AndroidCreatePackagePerAbi>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <WarningLevel>9999</WarningLevel>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='WATCH|AnyCPU'">
        <WarningLevel>9999</WarningLevel>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="11.1.3" />
        <PackageReference Include="Avalonia.Maui" Version="11.0.9" />
        <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.90" />
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.11" />
        <PackageReference Update="Microsoft.Maui.Controls" Version="8.0.90" />
        <PackageReference Update="Microsoft.Maui.Controls.Compatibility" Version="8.0.90" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SMassTrans.Avalonia\SMassTrans.Avalonia.csproj" />
    </ItemGroup>
</Project>
