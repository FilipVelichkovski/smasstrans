<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SMassTrans.Avalonia.ViewModels"
             xmlns:views="clr-namespace:SMassTrans.Avalonia.Views"
             xmlns:local="clr-namespace:SMassTrans.Avalonia"
             xmlns:lang="clr-namespace:SMassTrans.Avalonia.Lang"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SMassTrans.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE-->
    <vm:MainViewModel />
  </Design.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key='Light'>
                    <SolidColorBrush x:Key='ForegroundBrush'>Black</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key='Dark'>
                    <SolidColorBrush x:Key='ForegroundBrush'>#6FFFFFFF</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        <views:LineRouteIdConverter x:Key="lineRouteIdConverter"/>
    </UserControl.Resources>
    <Border x:Name="MainContentContainer">
    <Grid  x:Name="MainContent" RowDefinitions="*,30">
        <TabControl Name="TabCtl" SelectionChanged="SelectingItemsControl_OnSelectionChanged">
            <TabItem Header="{x:Static lang:Resources.Stops}" Content="{Binding StopContent}">
            </TabItem>
            <TabItem Header="{x:Static lang:Resources.StopsGPS}" Content="{Binding StopGPSContent}" IsVisible="{Binding Source={x:Static local:LocationGatherer.HasGps}}"> 
            </TabItem>
            <TabItem Header="{x:Static lang:Resources.Lines}" Content="{Binding LinePage}" >
                
            </TabItem>
            <TabItem Header="{x:Static lang:Resources.RouteFinder}" Content="{Binding RouteFindPage}" />
            <TabItem Header="Track Route" IsVisible="{Binding Source={x:Static local:LocationGatherer.HasGps}}" >
                <ContentControl Content="{Binding RouteTrackingPage}" />
            </TabItem>
            <TabItem Header="{Binding MapName}" Name="MapTabItem">
              <Grid RowDefinitions="11*,1*,1*" Name="mapTabGrid">
                  <TextBlock Grid.Row="1" Name="mapdata" TextWrapping="Wrap" FontSize="10"></TextBlock>
                  <Button Grid.Row="2" Click="GPSButton_OnClick" IsVisible="{Binding Source={x:Static local:LocationGatherer.HasGps}}" Content="{x:Static lang:Resources.GPSOnMap}"/>
              </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </Border>
</UserControl>
