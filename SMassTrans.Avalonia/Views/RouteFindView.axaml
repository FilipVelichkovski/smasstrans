<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:SMassTrans.Avalonia"
             x:Class="SMassTrans.Avalonia.Views.RouteFindView">
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="Route Finder" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Do not blindly trust the route finder, routes may be incorrect, it does not use live data" TextWrapping="Wrap" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="From:" VerticalAlignment="Center"/>
            <TextBox Name="FromTextBox" Width="240" Watermark="Type stop name or coordinates" HorizontalContentAlignment="Center"/>
            <Button Name="FromGpsBtn" Content="GPS" Width="50" Click="FromGpsBtn_Click"  IsVisible="{Binding Source={x:Static local:LocationGatherer.HasGps}}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="To:" VerticalAlignment="Center"/>
            <TextBox Name="ToTextBox" Width="240" Watermark="Type stop name or coordinates" HorizontalContentAlignment="Center"/>
            <Button Name="ToGpsBtn" Content="GPS" Width="50" Click="ToGpsBtn_Click" IsVisible="{Binding Source={x:Static local:LocationGatherer.HasGps}}"/>
        </StackPanel>
        <Button Grid.Row="4" Name="SwapBtn" Content="⇄"  Click="SwapBtn_Click"/>
        <Button Grid.Row="5" Name="FindRouteBtn" Content="Find Route" Margin="0,10,0,0" Click="OnFindRouteClick"/>
        <ScrollViewer Grid.Row="6"  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl Name="RouteResults" />
        </ScrollViewer>
    </Grid>
</UserControl>
