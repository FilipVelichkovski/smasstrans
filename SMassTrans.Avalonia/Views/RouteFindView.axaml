<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:SMassTrans.Avalonia"
             xmlns:lang="clr-namespace:SMassTrans.Avalonia.Lang"
             x:Class="SMassTrans.Avalonia.Views.RouteFindView">
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="{x:Static lang:Resources.RouteFinder}" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="{x:Static lang:Resources.RouteFinderWarning}" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{x:Static lang:Resources.From}" VerticalAlignment="Center"/>
            <TextBox Name="FromTextBox" Width="160" Watermark="Type stop name or coordinates"/>
            <Button Name="FromGpsBtn" Content="{x:Static lang:Resources.GPS}" Width="50" Click="FromGpsBtn_Click"  IsVisible="{Binding Source={x:Static local:LocationGatherer.HasGps}}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{x:Static lang:Resources.To}" VerticalAlignment="Center"/>
            <TextBox Name="ToTextBox" Width="160" Watermark="Type stop name or coordinates"/>
            <Button Name="ToGpsBtn" Content="{x:Static lang:Resources.GPS}" Width="50" Click="ToGpsBtn_Click" IsVisible="{Binding Source={x:Static local:LocationGatherer.HasGps}}"/>
        </StackPanel>
        <Button Grid.Row="4" Name="SwapBtn" Content="{x:Static lang:Resources.Swap}"  Click="SwapBtn_Click"/>
        <Button Grid.Row="5" Name="FindRouteBtn" Content="{x:Static lang:Resources.FindRoute}" Margin="0,10,0,0" Click="OnFindRouteClick"/>
        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl Name="RouteResults" />
        </ScrollViewer>
    </Grid>
</UserControl>
