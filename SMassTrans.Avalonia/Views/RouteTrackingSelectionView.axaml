<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SMassTrans.Avalonia.ViewModels"
             xmlns:lang="clr-namespace:SMassTrans.Avalonia.Lang"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SMassTrans.Avalonia.Views.RouteTrackingSelectionView"
             x:DataType="viewModels:RouteTrackingSelectionViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15" Margin="2">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Track Your Route" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Select a route to start tracking your journey" FontSize="14" Foreground="WhiteSmoke" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Loading Indicator -->
        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"
                   IsVisible="{Binding IsLoading}">
            <TextBlock Text="⏳" FontSize="40" TextAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding LoadingMessage}" FontSize="14" TextAlignment="Center"/>
        </StackPanel>

        <!-- Routes List -->
        <ListBox Grid.Row="1" ItemsSource="{Binding AvailableRoutes}" 
                IsVisible="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"
                Margin="2" DoubleTapped="RouteDoubleClicked">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15" Background="Transparent">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding StopsInfo}" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="→" FontSize="20" VerticalAlignment="Center" Foreground="#2196F3"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"
                   IsVisible="{Binding AvailableRoutes.Count, Converter={x:Static ObjectConverters.IsNull}}"
                   Spacing="10">
            <TextBlock Text="No routes available" FontSize="16" TextAlignment="Center"/>
            <Button Content="Refresh" Click="RefreshClick" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="2" Spacing="10">
            <Button Content="Refresh" Click="RefreshClick" 
                   Background="#2196F3" Foreground="White" Padding="15,10"/>
            <Button Content="Back" Click="BackClick"
                   Background="#666" Foreground="White" Padding="15,10"/>
        </StackPanel>
    </Grid>
</UserControl>
