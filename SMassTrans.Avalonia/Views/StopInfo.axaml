<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SMassTrans.Avalonia.ViewModels"
             xmlns:views="clr-namespace:SMassTrans.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SMassTrans.Avalonia.Views.StopInfo"
             x:DataType="viewModels:MainViewModel">
    <UserControl.Resources>
        <views:LineRouteIdConverter x:Key="lineRouteIdConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter  Property="Padding" Value="0"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,30">
        <RefreshContainer PullDirection="TopToBottom"
                          RefreshRequested="RefreshContainer_OnRefreshRequested">
                <ListBox Grid.Row="1" ItemsSource="{Binding BusesOnStop}" >
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
             
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Background="DarkBlue" Margin="2"   PointerReleased="LinePointerReleased"  >
                            <TextBlock Text="{Binding LineAndRoute, Converter={StaticResource lineRouteIdConverter}}" Margin="5,5,10,5" />
                            <TextBlock Text="{Binding Time}"  Margin="10,5,5,5" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
        </RefreshContainer>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Click="RefreshReqeusted">Refresh</Button>
            <Button Click="BackRequested">Back</Button>
        </StackPanel>
        
    </Grid>
</UserControl>
