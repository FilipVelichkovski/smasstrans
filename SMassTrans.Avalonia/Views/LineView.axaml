<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SMassTrans.Avalonia.ViewModels"
             xmlns:views="clr-namespace:SMassTrans.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SMassTrans.Avalonia.Views.LineView">
    <UserControl.Resources>
        <views:LineRouteIdConverter x:Key="lineRouteIdConverter"/>
    </UserControl.Resources>
    <Grid RowDefinitions="30,*">
        <TextBox Name="SearchBox" TextChanged="TextBox_OnTextChanged"></TextBox>
    <ListBox Grid.Row="1" Name="LineBox" Margin="0" Padding="0" ItemsSource="{Binding Lines}" x:DataType="viewModels:MainViewModel">
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border BorderThickness="1" BorderBrush="{DynamicResource ForegroundBrush}"  >
                    <StackPanel Margin="2" Orientation="Horizontal" Tapped ="LineDoubleTapped" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="GPS" Click="LineGPS"/>
                                <MenuItem Header="Copy stops to clipboard" Click="CopyStops"/>
                                <MenuItem Header="View stops" Click="ViewStops"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="{Binding LineRouteId, Converter={StaticResource lineRouteIdConverter}}" FontSize="18" Padding="0,10,5,0" />
                        <TextBlock Text="{Binding Name}" FontSize="18" Padding="0,10,5,0" />
                        <TextBlock Text="{Binding Direction}" FontSize="18" Padding="0,10,5,0" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
    </Grid>
</UserControl>
